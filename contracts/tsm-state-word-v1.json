{
  "schema": "tsm-state-word-contract",
  "version": 1,
  "bitWidth": 16,
  "endianness": "host_u16",
  "layout": {
    "B": { "bits": [0, 3], "width": 4, "range": [0, 15], "role": "boundary_proxy" },
    "D": { "bits": [4, 6], "width": 3, "range": [0, 7], "role": "geometric_detail" },
    "C": { "bits": [7, 9], "width": 3, "range": [0, 7], "role": "component_complexity" },
    "T": { "bits": [10, 12], "width": 3, "range": [0, 7], "role": "texture_appearance" },
    "S": { "bits": [13, 15], "width": 3, "range": [0, 7], "role": "semantic_depth" }
  },
  "managerLifecycle": {
    "note": "NOT packed in v1 word. Use SpatialEntityPhase enum separately.",
    "phases": ["UNLOADED", "DORMANT", "ACTIVE"]
  },
  "default": { "B": 3, "D": 5, "C": 2, "T": 3, "S": 2 },
  "propertyKey": "tsmStateWord",
  "layoutVersionKey": "tsmStateWordLayoutVersion"
}
