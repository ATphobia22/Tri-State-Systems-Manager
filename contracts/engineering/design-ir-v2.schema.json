{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://tsm.local/contracts/engineering/design-ir-v2.schema.json",
  "title":"TSM Design Intermediate Representation v2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","revision","status","crs","units","geometry","parameters","featureTree","simulation","evidence","uncertainty","provenance"],
  "properties":{
    "schemaVersion":{"const":"TSM-DesignIR-2.0"},
    "designId":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,96}$"},
    "revision":{"type":"integer","minimum":0},
    "status":{"enum":["conceptual","screening","engineering-review","fabrication-ready"]},
    "crs":{"type":"string","minLength":1},
    "verticalDatum":{"type":["string","null"]},
    "units":{"type":"string","enum":["SI","US-customary"]},
    "geometry":{"type":"object","additionalProperties":false,"required":["type","reference"],"properties":{
      "type":{"enum":["point","polyline","polygon","solid","surface","assembly"]},
      "reference":{"type":"string","minLength":1}
    }},
    "parameters":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","value","unit"],"properties":{
      "name":{"type":"string","minLength":1},"value":{"type":"number","finite":true},"unit":{"type":"string","minLength":1},"sourceRef":{"type":["string","null"]}
    }}},
    "featureTree":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","kind"],"properties":{
      "id":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"parentId":{"type":["string","null"]},"parameters":{"type":"array","items":{"type":"string"}}
    }}},
    "simulation":{"type":"object","additionalProperties":false,"required":["tags"],"properties":{
      "tags":{"type":"array","items":{"type":"string"}},"solver":{"type":["string","null"]},"resultRef":{"type":["string","null"]}
    }},
    "evidence":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","class","sha256"],"properties":{
      "id":{"type":"string","minLength":1},"class":{"enum":["observed","authoritative-regulatory","authoritative-reference","modeled-engineering","historical-reconstruction","screening-estimate","synthetic-assumption","cinematic-presentation"]},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"uri":{"type":["string","null"]}
    }}},
    "uncertainty":{"type":"object","additionalProperties":false,"required":["method","relativeBound"],"properties":{
      "method":{"type":"string","minLength":1},"relativeBound":{"type":"number","minimum":0},"notes":{"type":"string"}
    }},
    "provenance":{"type":"object","additionalProperties":false,"required":["sourceHashes","transformations"],"properties":{
      "sourceHashes":{"type":"array","items":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"transformations":{"type":"array","items":{"type":"string"}}
    }}
  }
}