{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsm.local/contracts/quantum/ibm-quantum-result-v1.schema.json",
  "title": "TSM IBM Quantum Result Artifact v1",
  "description": "Quarantined execution receipt. This artifact is not an authoritative engineering result and must pass independent domain validation before conversion to Solver Result v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workloadId",
    "provider",
    "apiVersion",
    "primitive",
    "backend",
    "jobId",
    "remoteStatus",
    "inputArtifactSha256",
    "circuitArtifactSha256",
    "resultArtifactSha256",
    "authorityClass",
    "outputPolicy",
    "submittedAt",
    "retrievedAt",
    "validationStatus",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "TSM-IBMQuantumResult-1.0" },
    "workloadId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "provider": { "const": "ibm-quantum-compute-service" },
    "apiVersion": { "type": "string", "const": "2026-04-15" },
    "primitive": { "const": "sampler" },
    "backend": { "type": "string", "minLength": 1, "maxLength": 200 },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "remoteStatus": { "enum": ["Queued", "Running", "Completed", "Cancelled", "Cancelled - Ran too long", "Failed", "Unknown"] },
    "inputArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "circuitArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resultArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorityClass": { "const": "DERIVED" },
    "outputPolicy": { "const": "quarantine" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "validationStatus": { "enum": ["pending", "passed", "failed"] },
    "shots": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "errorCode": { "type": "string", "maxLength": 128 }
  }
}
