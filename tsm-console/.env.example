# Canonical hosted deployment configuration.
# Never commit populated values. Use the deployment platform's secret/environment store.

TSM_AUTH_MODE=required
OIDC_ISSUER=https://YOUR-KEYCLOAK.example/realms/tsm
OIDC_AUDIENCE=tsm-console-api
OIDC_CLIENT_ID=tsm-console-bff
OIDC_REDIRECT_URI=https://api.YOUR-APP.example/api/auth/callback
# Required for hosted BFF mode; store only in the deployment secret manager.
OIDC_CLIENT_SECRET=
OIDC_JWKS_URL=
OIDC_SCOPES=openid profile email roles

# Minimum 32 characters; generate with: openssl rand -base64 48
TSM_SESSION_SECRET=
TSM_BROWSER_SESSION_MAX_AGE_SEC=900
# Use Strict/Lax when web and API are same-site. Use None only for a deliberately
# cross-site frontend/API deployment, and only over HTTPS.
TSM_COOKIE_SAMESITE=Lax
TSM_COOKIE_SECURE=true

TSM_OPERATOR_ROLE=tsm-operator
TSM_REVIEWER_ROLE=tsm-reviewer
CORS_ORIGIN=https://YOUR-APP.example
VITE_TSM_API_BASE_URL=https://api.YOUR-APP.example
PORT=8787
TSM_EVIDENCE_DIR=/app/.data

# Optional machine telemetry ingress. Keep these in a secret manager.
TSM_EVENT_INGEST_USERNAME=
TSM_EVENT_INGEST_PASSWORD=

# Optional PostgreSQL profile.
POSTGRES_USER=tsm
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=tsm_evidence

# Local-only development:
# TSM_AUTH_MODE=disabled
# TSM_COOKIE_SECURE=false

# Digital Twin V2 — optional live sources. Do not populate with undocumented WTH GIS endpoints.
# The parcel endpoint must return GeoJSON in EPSG:4326/CRS84; engineering data remains EPSG:2966.
VITE_POSEY_WTHGIS_GEOJSON_URL=
VITE_TSM_POINT_TOWNSHIP_BFE_FT_NAVD88=375.0
# Backend bridge endpoint that returns validated NAVD88 WSE messages derived from OpenMI exchange.
VITE_TSM_OPENMI_WSE_URL=
# Optional water-body polygon GeoJSON in EPSG:4326. WSE is applied as a visual extrusion only.
VITE_TSM_OPENMI_WATER_GEOJSON_URL=

# Flood simulator live terrain tiles: base URL of a Terrain-RGB (or Terrarium)
# XYZ tile pyramid, e.g. https://tiles.example.com/terrain-rgb
# A URL containing "terrain-rgb" selects the Terrain-RGB decoder, otherwise
# Terrarium is assumed. Unset = AWS elevation-tiles-prod Terrarium (default).
VITE_TSM_TERRAIN_TILE_URL=

# ---------------------------------------------------------------------------
# MapLibre 3D terrain (Terrain-RGB) — FAIL-CLOSED when unset or placeholder
# ---------------------------------------------------------------------------
# Absolute HTTPS XYZ template with {z}/{x}/{y} tokens, produced from real
# USGS 3DEP (or best-available lidar) via the documented Terrain-RGB pipeline.
# When empty/placeholder, MapLibre setTerrain() is not called; no synthetic mesh.
# See docs/TERRAIN-RGB-3DEP-PIPELINE.md and tsm-console/config/terrain-pipeline.json
# Production Pages deployment:
#   https://atphobia22.github.io/Tri-State-Systems-Manager/terrain_3dep/{z}/{x}/{y}.png
# (tiles ship in public/terrain_3dep/ — see its README for the carve-out).
# VITE_TSM_TERRAIN_RGB_URL_TEMPLATE=https://atphobia22.github.io/Tri-State-Systems-Manager/terrain_3dep/{z}/{x}/{y}.png
VITE_TSM_TERRAIN_RGB_URL_TEMPLATE=
