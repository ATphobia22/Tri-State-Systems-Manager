# Tri-State Systems Manager — credential-free local OSS defaults
# Browser authentication is a Keycloak public client using Authorization Code + PKCE (S256).
# Never place client secrets, service credentials, Databricks PATs, or signing keys in VITE_* variables.

VITE_KEYCLOAK_URL=http://localhost:8080/realms/tsm
VITE_KEYCLOAK_REALM=tsm
VITE_KEYCLOAK_CLIENT_ID=tsm-console
VITE_IDP_PROVIDER=keycloak
VITE_IDP_AUTHORITY=http://localhost:8080/realms/tsm
VITE_IDP_CLIENT_ID=tsm-console
VITE_IDP_REDIRECT_URI=http://localhost:5173/login/callback
VITE_IDP_SCOPES=openid profile email

# API runtime
PORT=8787
CORS_ORIGIN=http://localhost:5173
# Browser -> Node API. Empty uses same-origin /api behind a reverse proxy.
VITE_TSM_API_BASE_URL=

# Operational 3DEP terrain. Supply a real, provenance-tracked Terrain-RGB XYZ template.
# Example shape only; do not use this host.
VITE_TSM_TERRAIN_RGB_URL_TEMPLATE=

# Optional live event bus (Kafka Connect REST Proxy compatible).
# Keep credentials server-side; do not expose them through VITE_*.
TSM_EVENT_BUS_ENABLED=false
TSM_KAFKA_REST_URL=
TSM_KAFKA_TOPIC=tsm.telemetry.v1
TSM_KAFKA_USERNAME=
TSM_KAFKA_PASSWORD=

# Optional Databricks lakehouse deployment is configured in GitHub Actions Environment "prod".
# Required GitHub Environment variables: DATABRICKS_HOST, DATABRICKS_CLIENT_ID.
# Authentication uses GitHub OIDC federation; no DATABRICKS_TOKEN is required.

# Backend remains free of browser-exposed IdP client secrets.
# IDP_TOKEN_URL=
# IDP_CLIENT_SECRET=
# IDP_AUDIENCE=
