# Identity Provider (OIDC)
VITE_IDP_PROVIDER=mock
# VITE_IDP_PROVIDER=oidc
# VITE_IDP_AUTHORITY=https://your-tenant.auth0.com
# VITE_IDP_CLIENT_ID=your-client-id
# VITE_IDP_REDIRECT_URI=http://localhost:5173/login/callback

# Backend token proxy (server-side secrets only)
IDP_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
IDP_CLIENT_SECRET=
IDP_AUDIENCE=
PORT=8787
