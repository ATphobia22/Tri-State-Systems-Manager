# Tri-State Systems Manager — credential-free local OSS defaults
#
# Authentication uses a self-hosted Keycloak OIDC provider.
# Keycloak is Apache-2.0 licensed:
# https://github.com/keycloak/keycloak
#
# No Auth0, Okta, Entra ID, Google, OpenAI, Groq, Gemini, IBM, or OpenRouter
# credentials are required by the application.

# Browser OIDC configuration
VITE_IDP_PROVIDER=keycloak
VITE_IDP_AUTHORITY=http://localhost:8080/realms/tsm
VITE_IDP_CLIENT_ID=tsm-console
VITE_IDP_REDIRECT_URI=http://localhost:5173/login/callback
VITE_IDP_SCOPES=openid profile email

# Backend is intentionally not configured with an IdP client secret.
# The SPA uses a Keycloak public client with Authorization Code + PKCE.
# These legacy secret-bearing variables must remain unset:
# IDP_TOKEN_URL=
# IDP_CLIENT_SECRET=
# IDP_AUDIENCE=

# API
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Optional local AI runtime — no API key required.
# Ollama: https://github.com/ollama/ollama
# llama.cpp: https://github.com/ggml-org/llama.cpp
#
# Example:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
