{
  "version": 2,
  "purpose": "Open-source geospatial toolchain contract for agency-reviewable processing",
  "tools": {
    "pdal": {
      "role": "point-cloud ingestion, filtering, reprojection and rasterization",
      "minimum_version": "2.10.2",
      "container": "pdal/pdal:2.10.2",
      "upstream": "https://github.com/PDAL/PDAL"
    },
    "gdal": {
      "role": "raster inspection, conversion and metadata validation",
      "upstream": "https://github.com/OSGeo/gdal"
    },
    "mapnik": {
      "role": "cartographic rendering",
      "upstream": "https://github.com/mapnik/mapnik"
    },
    "h3": {
      "role": "hierarchical spatial indexing",
      "upstream": "https://github.com/uber/h3"
    },
    "martin": {
      "role": "PostGIS/vector tile serving",
      "upstream": "https://github.com/maplibre/martin"
    },
    "3d-tiles-renderer": {
      "role": "OGC 3D Tiles browser renderer for Three.js/React Three Fiber",
      "package": "3d-tiles-renderer",
      "pinned_version": "0.5.2",
      "upstream": "https://github.com/NASA-AMMOS/3DTilesRendererJS",
      "license": "Apache-2.0"
    },
    "h3-js": {
      "role": "client-side H3 spatial indexing and aggregation",
      "package": "h3-js",
      "pinned_version": "4.5.0",
      "upstream": "https://github.com/uber/h3-js",
      "license": "Apache-2.0"
    },
    "pmtiles": {
      "role": "browser/server PMTiles archive access and MapLibre protocol integration",
      "package": "pmtiles",
      "pinned_version": "4.5.0",
      "upstream": "https://github.com/protomaps/PMTiles",
      "license": "BSD-3-Clause"
    },
    "protomaps": {
      "role": "reproducible OSM/Natural Earth basemap PMTiles generation",
      "upstream": "https://github.com/protomaps/basemaps",
      "license": "BSD-3-Clause",
      "dataLicense": "ODbL for OSM-derived tiles",
      "attributionRequired": true
    },
    "samgeo": {
      "role": "offline/async geospatial image segmentation; AI-derived output only",
      "upstream": "https://github.com/opengeos/segment-geospatial",
      "license": "MIT",
      "humanReviewRequired": true
    },
    "tooljet": {
      "role": "isolated internal operations/admin console",
      "upstream": "https://github.com/ToolJet/ToolJet",
      "license": "AGPL-3.0",
      "deploymentBoundary": "separate-service"
    },
    "mercator": {
      "role": "architecture/dependency-graph reference only",
      "upstream": "https://github.com/mercator-hq/mercator",
      "sourceIntegration": "do-not-vendor-application"
    },
    "mapillary-js": {
      "role": "street-level observational evidence viewer",
      "upstream": "https://github.com/mapillary/mapillary-js",
      "license": "BSD-2-Clause",
      "authority": "observational_reference_only",
      "humanReviewRequired": true
    },
    "baremaps": {
      "role": "offline OSM/data ingestion and vector-tile generation",
      "upstream": "https://github.com/baremaps/baremaps",
      "license": "BSD-3-Clause",
      "dataLicense": "ODbL for OSM-derived data",
      "attributionRequired": true
    },
    "3d-tiles-tools": {
      "role": "OGC 3D Tiles conversion/optimization/validation tooling",
      "upstream": "https://github.com/CesiumGS/3d-tiles-tools",
      "license": "Apache-2.0",
      "authority": "visualization_and_interchange_only"
    },
    "hec-commander": {
      "role": "HEC-RAS/HEC-HMS automation reference; isolated worker integration only",
      "upstream": "https://github.com/billk-FM/HEC-Commander",
      "authority": "automation_reference_only",
      "humanReviewRequired": true
    },
    "rayshader": {
      "role": "analytical terrain/hillshade export",
      "upstream": "https://github.com/tylermorganwall/rayshader",
      "license": "GPL-3.0",
      "deploymentBoundary": "offline_analysis",
      "authority": "derived_analysis_only"
    },
    "openusd-hydra": {
      "role": "native engineering workstation/OpenUSD/Hydra reference",
      "upstream": "https://github.com/PixarAnimationStudios/OpenUSD",
      "deploymentBoundary": "native_workstation",
      "authority": "presentation_only"
    },
    "arcgis-maps-sdk-qt": {
      "role": "native GIS companion client reference",
      "upstream": "https://github.com/Esri/arcgis-maps-sdk-toolkit-qt",
      "deploymentBoundary": "native_workstation",
      "authority": "presentation_and_analysis_client"
    }
  },
  "policy": {
    "raw_lidar_committed": false,
    "derived_artifacts_committed": false,
    "source_provenance_required": true,
    "engineering_values_are_not_certified_by_ci": true,
    "ai_derived_results_require_human_review": true,
    "osm_derived_tiles_require_visible_attribution": true,
    "agpl_services_must_remain_process_isolated": true,
    "3d_tiles_renderer_is_visualization_only": true,
    "observational_imagery_requires_human_review": true,
    "historical_records_are_reference_evidence": true,
    "hec_model_results_require_input_and_result_hashes": true,
    "presentation_outputs_cannot_be_promoted_to_evidence": true
  }
}
