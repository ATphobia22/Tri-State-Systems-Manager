{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tri-State Systems Manager",
  "version": "0.2.1",
  "identifier": "org.tristate.tsm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tri-State Systems Manager",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: http://localhost:* ws://localhost:*; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg"
    ],
    "createUpdaterArtifacts": false,
    "shortDescription": "Community-scale engineering and spatial decision support",
    "longDescription": "Tri-State Systems Manager desktop console for geospatial, hydrologic, engineering, evidence, and community decision-support workflows.",
    "category": "Utility",
    "copyright": "Tri-State Systems Manager",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 720,
          "height": 480
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "tsmproj"
        ],
        "name": "TSM Project",
        "description": "Tri-State Systems Manager project",
        "mimeType": "application/x-tsm-project",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "org.tristate.tsm.tsmproj",
          "conformsTo": [
            "public.data"
          ]
        }
      },
      {
        "ext": [
          "pmtiles"
        ],
        "name": "PMTiles Archive",
        "description": "PMTiles geospatial archive",
        "mimeType": "application/vnd.pmtiles",
        "role": "Viewer",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "org.tristate.tsm.pmtiles",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/ATphobia22/Tri-State-Systems-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}