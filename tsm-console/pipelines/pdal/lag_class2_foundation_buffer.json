{
  "pipeline": [
    {
      "type": "readers.las",
      "tag": "src",
      "filename": "data/lidar/posey/las/IN2020_26800940_12.las",
      "default_srs": "EPSG:2966"
    },
    {
      "type": "filters.crop",
      "tag": "buffer",
      "inputs": ["src"],
      "polygon": "POLYGON((0 0,1 0,1 1,0 1,0 0))",
      "a_srs": "EPSG:2966"
    },
    {
      "type": "filters.expression",
      "tag": "class2",
      "inputs": ["buffer"],
      "expression": "Classification == 2"
    },
    {
      "type": "filters.stats",
      "tag": "zstats",
      "inputs": ["class2"],
      "dimensions": "Z",
      "global": "Z"
    },
    {
      "type": "writers.text",
      "tag": "out",
      "inputs": ["class2"],
      "filename": "data/lidar/posey/lag_class2_z.csv",
      "order": "X,Y,Z",
      "keep_unspecified": false
    }
  ]
}
