{
  "id": "tsm-nfhl-operational",
  "version": 8,
  "name": "TSM NFHL Priority Operational",
  "metadata": {
    "tsm.authority": "REGULATORY_DISPLAY",
    "tsm.note": "Vector tiles assume Martin/PostGIS MVT publish of nfhl_features. Until then use MapServer export image overlay from NfhlLayerRegistry."
  },
  "sources": {
    "nfhl": {
      "type": "vector",
      "tiles": ["/tiles/nfhl/{z}/{x}/{y}.pbf"],
      "minzoom": 8,
      "maxzoom": 16
    }
  },
  "layers": [
    {
      "id": "sfha-fill",
      "type": "fill",
      "source": "nfhl",
      "source-layer": "flood_hazard_zones",
      "metadata": { "nfhlLayerId": 28 },
      "paint": {
        "fill-color": "#2563eb",
        "fill-opacity": 0.35
      }
    },
    {
      "id": "flood-boundary",
      "type": "line",
      "source": "nfhl",
      "source-layer": "flood_hazard_boundaries",
      "metadata": { "nfhlLayerId": 27 },
      "paint": {
        "line-color": "#1d4ed8",
        "line-width": 1.5
      }
    },
    {
      "id": "levees",
      "type": "line",
      "source": "nfhl",
      "source-layer": "levees",
      "metadata": { "nfhlLayerId": 23 },
      "paint": {
        "line-color": "#dc2626",
        "line-width": 3
      }
    },
    {
      "id": "bfe-lines",
      "type": "line",
      "source": "nfhl",
      "source-layer": "base_flood_elevations",
      "metadata": { "nfhlLayerId": 16 },
      "paint": {
        "line-color": "#0891b2",
        "line-width": 2
      }
    },
    {
      "id": "loma-points",
      "type": "circle",
      "source": "nfhl",
      "source-layer": "lomas",
      "metadata": { "nfhlLayerId": 34 },
      "paint": {
        "circle-radius": 5,
        "circle-color": "#f59e0b"
      }
    }
  ]
}
