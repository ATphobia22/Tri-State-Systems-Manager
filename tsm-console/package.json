{
  "name": "tsm-console",
  "version": "0.2.1",
  "private": true,
  "description": "Tri-State Systems Manager — government engineering decision-support console",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node server/token-proxy.mjs",
    "dev:all": "node server/token-proxy.mjs & vite",
    "telemetry:server": "node server/telemetry-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "proxy": "node server/token-proxy.mjs",
    "ingest": "node -e \"import('./server/ingestion/workers.mjs').then(m => m.runHydrologicBatch().then(r => console.log(JSON.stringify(r,null,2))))\"",
    "buf:lint": "buf lint",
    "buf:gen": "buf generate",
    "buf:breaking": "buf breaking --against .git#branch=main",
    "proto:all": "buf lint && buf generate",
    "postinstall": "node scripts/postinstall-check.mjs",
    "test": "node --test tests/geodetic-pipeline.test.mjs",
    "test:all": "node --test 'tests/**/*.test.mjs' 'server/**/*.test.mjs' && vitest run --exclude '**/*.test.mjs'",
    "tauri": "cargo tauri",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build",
    "desktop:build:windows": "cargo tauri build --bundles nsis,msi",
    "desktop:build:macos": "cargo tauri build --bundles dmg",
    "desktop:build:linux": "cargo tauri build --bundles appimage,deb",
    "desktop:build:all": "cargo tauri build --bundles nsis,msi,dmg,appimage,deb",
    "desktop:check": "node scripts/desktop-updater-check.mjs",
    "ci": "npm run check:production-reliability && npm run check:action-pins && npm run check:dependency-integrity && npm run check:npx-policy && npm run check:integrity && npm run check:capabilities && npm run check:capability-control-plane && npm run check:workflow-boundaries && npm run check:artifacts && npm run check:quantum-boundary && npm run check:shell-safety && npm run check:site-consistency && npm run check:community-engineering-boundaries && npm run check:mock-data && npm run check:tile-health && npm run check:parse && npm run check:type && npm run check:geospatial && npm run check:government-sources && npm run check:live-fabric && npm run check:regulatory-rules && npm run check:engineering-pipeline && npm run check:schemas && npm run build && npm run check:client-bundle-secrets && npm run check:enterprise-architecture && npm run check:architecture-repository && npm run check:data-fabric-contract && npm run check:provenance-plane && npm run test:production-gates",
    "ci:full": "npm run ci && npm run test:all && npm run test:geodetic && npm run test:ingestion && npm run test:production-gates && npm run ingest",
    "check:schemas": "node ../scripts/ci/validate-json-schemas.mjs",
    "check:client-bundle-secrets": "node scripts/check-client-bundle-secrets.mjs",
    "test:production-gates": "node --test tests/production-gates.test.mjs",
    "check:mock-data": "node ../scripts/no-production-mock-data.mjs .",
    "check:parse": "node scripts/parse-check.mjs",
    "check:type": "tsc --noEmit",
    "check:integrity": "node scripts/repository-integrity-check.mjs",
    "check:dependency-integrity": "node scripts/dependency-integrity.mjs",
    "check:npx-policy": "node scripts/npx-policy-check.mjs",
    "check:tile-health": "node scripts/geospatial/tile-health-check.mjs",
    "check:geospatial": "node scripts/geospatial/validate-processing-contract.mjs",
    "check:government-sources": "node scripts/geospatial/validate-government-sources.mjs",
    "check:live-fabric": "node ../scripts/ci/validate-live-fabric.mjs",
    "check:regulatory-rules": "node ../scripts/ci/validate-regulatory-rules.mjs",
    "check:engineering-pipeline": "node ../scripts/ci/validate-engineering-pipeline.mjs",
    "check:action-pins": "node ../scripts/ci/validate-action-pins.mjs",
    "check:production-reliability": "node ../scripts/ci/validate-production-reliability.mjs",
    "check:capabilities": "node ../scripts/ci/validate-capability-registry.mjs",
    "check:capability-control-plane": "node ../scripts/ci/validate-capability-control-plane.mjs",
    "check:workflow-boundaries": "node ../scripts/ci/validate-workflow-boundaries.mjs",
    "check:artifacts": "node ../scripts/ci/validate-artifact-manifests.mjs",
    "check:quantum-boundary": "node ../scripts/ci/validate-quantum-boundary.mjs",
    "check:shell-safety": "bash ../scripts/ci/validate-shell-safety.sh",
    "check:site-consistency": "node ../scripts/ci/validate-site-consistency.mjs",
    "check:community-engineering-boundaries": "node ../scripts/ci/validate-community-engineering-boundaries.mjs",
    "check:enterprise-architecture": "node ../scripts/ci/validate-enterprise-data-architecture.mjs",
    "check:architecture-repository": "node ../scripts/ci/validate-architecture-repository.mjs",
    "check:data-fabric-contract": "node ../scripts/ci/validate-data-fabric-contract.mjs",
    "check:provenance-plane": "node ../scripts/ci/validate-provenance-plane.mjs",
    "resync": "npm ci --no-audit --no-fund && node scripts/postinstall-check.mjs && node scripts/parse-check.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "6.10.0",
    "react": "19.2.8",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.0",
    "geotiff": "^3.0.5",
    "3d-tiles-renderer": "^0.5.3",
    "h3-js": "4.5.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@webgpu/types": "^0.1.74"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0"
  }
}
