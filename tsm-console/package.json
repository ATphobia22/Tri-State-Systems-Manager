{
  "name": "tsm-console",
  "version": "0.2.1",
  "private": true,
  "description": "Tri-State Systems Manager — government engineering decision-support console",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/geodetic-pipeline.test.mjs",
    "ci": "npm run check:full-tree-hardening && npm run check:engineering-fabric && npm run check:native-product && npm run check:action-pins && npm run check:file-health && npm run check:parse && npm run check:type && npm run check:geospatial && npm run check:flood-federation && npm run check:openfema && npm run check:tri-state-data && npm run check:government-sources && npm run check:live-fabric && npm run check:regulatory-rules && npm run check:engineering-pipeline && npm run check:schemas && npm run check:spatial-runtime && npm run check:h3-migration && npm run build && npm run check:client-bundle-secrets && npm run check:enterprise-architecture && npm run check:architecture-repository && npm run check:data-fabric-contract && npm run check:provenance-plane && npm run test:production-gates && npm run check:external-tooling && npm run check:3d-tiles-tools && npm run test:external-capabilities",
    "ci:full": "npm run ci && npm run test:all && npm run test:backend",
    "check:action-pins": "node ../scripts/ci/validate-action-pins.mjs",
    "check:schemas": "node ../scripts/ci/validate-json-schemas.mjs",
    "test:production-gates": "node --test tests/production-gates.test.mjs",
    "test:agent-autonomy": "node --test tests/agent-autonomy.test.mjs",
    "storybook": "echo 'Storybook optional: install storybook@9+ when Vite 8 peer support is available' && exit 0",
    "storybook:build": "echo 'Storybook build skipped (optional)' && exit 0",
    "check:file-health": "node ../scripts/ci/validate-system-quality.mjs",
    "check:integrity": "node scripts/repository-integrity-check.mjs",
    "check:site-consistency": "node ../scripts/ci/validate-site-consistency.mjs",
    "check:parse": "node scripts/parse-check.mjs",
    "check:type": "tsc --noEmit",
    "check:geospatial": "bash ../scripts/ci/geospatial-contract.sh",
    "check:government-sources": "node scripts/geospatial/validate-government-sources.mjs",
    "check:live-fabric": "node ../scripts/ci/validate-live-fabric.mjs",
    "check:regulatory-rules": "node ../scripts/ci/validate-regulatory-rules.mjs",
    "check:engineering-pipeline": "node ../scripts/ci/validate-engineering-pipeline.mjs",
    "check:client-bundle-secrets": "node scripts/check-client-bundle-secrets.mjs",
    "check:enterprise-architecture": "node ../scripts/ci/validate-enterprise-data-architecture.mjs",
    "check:architecture-repository": "node ../scripts/ci/validate-architecture-repository.mjs",
    "check:data-fabric-contract": "node ../scripts/ci/validate-data-fabric-contract.mjs",
    "check:provenance-plane": "node ../scripts/ci/validate-provenance-plane.mjs",
    "check:v35.1": "tsc --noEmit -p tsconfig.v35.1.json",
    "check:v35": "npm run check:v35.1",
    "test:geodetic": "node --test tests/geodetic-pipeline.test.mjs",
    "test:all": "node --experimental-strip-types --test tests/*.test.mjs && vitest run tests/*.test.ts",
    "test:v35.1": "vitest run tests/v35.1-contracts.test.ts",
    "test:v35": "npm run test:v35.1",
    "sign:evidence": "node --experimental-strip-types ../scripts/sign-evidence.ts",
    "test:evidence-signer": "node ../scripts/evidence/test-sign-evidence.mjs",
    "test:loma-signing": "node ../scripts/evidence/test-loma-signing.mjs",
    "test:mapillary": "vitest run tests/mapillary-evidence-contract.test.ts",
    "test:geospatial-tile-fabric": "node --test tests/geospatial-tile-fabric-contract.test.mjs",
    "check:tile-health": "node scripts/geospatial/tile-health-check.mjs",
    "test:twin": "node --test tests/open-world-twin-contract.test.mjs",
    "test:hec-ras": "node --test tests/hec-ras-contract.test.mjs tests/hec-ras-modern-runtime.test.mjs",
    "test:cinematic": "vitest run tests/cinematic-camera-tour.test.ts tests/cinematic-contracts.test.ts",
    "geospatial:fetch": "node scripts/geospatial/fetch-posey-assets.mjs",
    "geospatial:validate": "node scripts/geospatial/validate-raster-manifest.mjs",
    "test:firm": "node --test tests/firm-*.test.mjs",
    "proxy": "node server/token-proxy.mjs",
    "dev:proxy": "node server/token-proxy.mjs",
    "telemetry:server": "node server/telemetry-server.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "check:system-quality": "node ../scripts/ci/validate-system-quality.mjs",
    "desktop:build:windows": "npm run build && cargo tauri build --bundles nsis,msi",
    "tauri:build": "tauri build --bundles nsis,msi",
    "desktop:build:macos": "npm run build && cargo tauri build --bundles dmg",
    "desktop:build:linux": "npm run build && cargo tauri build --bundles appimage,deb",
    "check:dependency-integrity": "node scripts/dependency-integrity.mjs",
    "check:npx-policy": "node scripts/npx-policy-check.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "check:flood-federation": "node ../scripts/ci/validate-flood-federation.mjs",
    "geospatial:verify-sources": "node ../scripts/geospatial/acquire-authoritative-source-metadata.mjs",
    "check:tri-state-data": "node ../scripts/geospatial/validate-tri-state-data-sources.mjs",
    "test:placement-screening": "node --test server/engineering/placement-screening.test.mjs",
    "check:external-tooling": "node ../scripts/ci/validate-external-tooling.mjs",
    "install:external-tooling": "node ../scripts/ci/install-external-tooling.mjs",
    "check:3d-tiles-tools": "node ../scripts/ci/validate-3d-tiles-tools.mjs",
    "test:external-capabilities": "node --test server/routing/osrm-client.test.mjs ../integrations/unity-mcp/gateway.test.mjs",
    "check:full-tree-hardening": "python3 ../scripts/ci/full-tree-hardening.py",
    "check:native-product": "node ../scripts/ci/validate-native-product-contract.mjs",
    "third-party:bootstrap": "node ../scripts/third-party/bootstrap.mjs --all",
    "check:engineering-fabric": "node ../scripts/ci/validate-engineering-fabric.mjs",
    "test:engineering-fabric": "node --test tests/engineering-fabric-contract.test.mjs",
    "check:spatial-runtime": "node ../scripts/geospatial/validate-spatial-runtime-manifests.mjs",
    "test:spatial-runtime": "node --test ../tests/spatial-runtime-contract.test.mjs",
    "check:openfema": "node ../scripts/ci/validate-openfema.mjs",
    "test:openfema": "node --test tests/openfema.test.mjs tests/posey-spatial-chain.test.mjs",
    "check:hec-ras-modern-runtime": "node ../scripts/ci/validate-hec-ras-modern-runtime.mjs",
    "runtime:doctor": "node ../scripts/offline/doctor.mjs",
    "runtime:verify": "node ../scripts/offline/verify-installed-runtime.mjs",
    "test:backend": "bash ../run-backend-tests.sh",
    "check:h3-migration": "node ../scripts/ci/validate-h3-migration-contract.mjs",
    "build:terrain-3d-tiles": "python3 ../scripts/geospatial/build-terrain-3d-tiles.py",
    "validate:terrain-3d-tiles": "python3 ../scripts/geospatial/validate-terrain-3d-tiles.py"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@deck.gl/aggregation-layers": "^9.4.0",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@meta2d/core": "^1.1.32",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-virtual": "^3.14.13",
    "3d-tiles-renderer": "^0.5.3",
    "cesium": "^1.146.0",
    "geotiff": "^3.0.5",
    "h3-js": "4.5.0",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.12.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "vite-plugin-cesium": "^1.2.23"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-darwin-x64": "1.33.0",
    "lightningcss-win32-arm64-msvc": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "cypress": "16.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "source-map-js": "^1.2.2"
  }
}
