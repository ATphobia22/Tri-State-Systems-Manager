{
  "name": "tsm-console",
  "version": "0.2.0",
  "private": true,
  "description": "Tri-State Systems Manager — Infinite Orchestration Console",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node server/token-proxy.mjs",
    "dev:all": "node server/token-proxy.mjs & vite",
    "check:parse": "node scripts/parse-check.mjs",
    "check:type": "tsc -b --noEmit",
    "check": "npm run check:parse && npm run check:type",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "proxy": "node server/token-proxy.mjs",
    "ingest": "node -e \"import('./server/ingestion/workers.mjs').then(m => m.runHydrologicBatch().then(r => console.log(JSON.stringify(r,null,2))))\"",
    "buf:lint": "buf lint",
    "buf:gen": "buf generate",
    "buf:breaking": "buf breaking --against \\".git#branch=main\\"",
    "proto:all": "buf lint && buf generate",
    "postinstall": "echo \\"[tsm] Optional: npm run proto:all after installing @bufbuild/buf\\"",
    "test": "node --test tests/geodetic-pipeline.test.mjs tests/solar-engine.test.mjs tests/compensatory-storage.test.mjs tests/router-source.test.mjs",
    "test:geodetic": "node --test tests/geodetic-pipeline.test.mjs",
    "test:solar": "node --test tests/solar-engine.test.mjs",
    "test:engineering": "node --test tests/compensatory-storage.test.mjs",
    "test:router": "node --test tests/router-source.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "three": "^0.170.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/drei": "^10.0.0",
    "maplibre-gl": "^4.7.1",
    "lucide-react": "^0.468.0",
    "@tanstack/react-virtual": "^3.11.0",
    "@bufbuild/protobuf": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@bufbuild/buf": "^1.47.0",
    "@bufbuild/protoc-gen-es": "^2.2.0"
  }
}
