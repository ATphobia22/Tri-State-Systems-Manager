{
  "name": "tsm-console",
  "version": "0.2.1",
  "private": true,
  "description": "Tri-State Systems Manager — government engineering decision-support console",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node server/token-proxy.mjs",
    "dev:all": "node server/token-proxy.mjs & vite",
    "telemetry:server": "node server/telemetry-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "proxy": "node server/token-proxy.mjs",
    "ingest": "node -e \"import('./server/ingestion/workers.mjs').then(m => m.runHydrologicBatch().then(r => console.log(JSON.stringify(r,null,2))))\"",
    "buf:lint": "buf lint",
    "buf:gen": "buf generate",
    "buf:breaking": "buf breaking --against .git#branch=main",
    "proto:all": "buf lint && buf generate",
    "postinstall": "node scripts/postinstall-check.mjs",
    "test": "node --test tests/geodetic-pipeline.test.mjs",
    "test:all": "node --test 'tests/**/*.test.mjs' 'server/**/*.test.mjs' && vitest run --exclude '**/*.test.mjs'",
    "test:telemetry": "node --test tests/telemetry-contract.test.mjs",
    "test:router": "node --test tests/router-source.test.mjs",
    "test:data-fabric": "node --test tests/data-fabric-contract.test.mjs",
    "test:twin": "node --test tests/open-world-twin-contract.test.mjs",
    "test:hec-ras": "node --test tests/hec-ras-contract.test.mjs",
    "test:evidence": "node --test tests/evidence-artifact-contract.test.mjs",
    "test:ingestion": "node --test server/ingestion/*.test.mjs",
    "test:engineering": "node --test server/engineering/*.test.mjs server/evidence/*.test.mjs tests/community-engineering-data-contract.test.mjs",
    "test:community-privacy": "node ../tests/privacy-community-scope.test.mjs",
    "test:community-river": "node --test tests/river-gauges-community.test.mjs tests/privacy-community-scope.test.mjs",
    "test:community-engineering-boundary": "node --test ../tests/community-engineering-boundary.test.mjs",
    "test:deployment": "node --test tests/community-deployment-contract.test.mjs",
    "test:reliability": "node --test tests/reliability-primitives.test.mjs tests/production-reliability.test.mjs tests/source-health.test.mjs tests/source-freshness.test.mjs tests/dependency-integrity.test.mjs tests/source-fabric.test.mjs",
    "test:posey": "vitest run tests/posey-ledger.test.ts",
    "test:geodetic": "node --test tests/geodetic-pipeline.test.mjs",
    "test:firm": "node --test tests/firm-*.test.mjs",
    "test:mock-data": "node ../scripts/no-production-mock-data.test.mjs",
    "test:martin": "vitest run tests/martin-tile-fabric.test.ts tests/hydraulic-rendering.test.ts",
    "test:geospatial-tile-fabric": "node --test tests/geospatial-tile-fabric-contract.test.mjs tests/geospatial-tile-source-resolver.test.mjs tests/open-world-terrain-imagery.test.mjs tests/open-world-overlays.test.mjs tests/open-world-hydrology.test.mjs tests/open-world-visual-layer-contract.test.mjs tests/historical-point-township.test.mjs tests/tile-health-contract.test.mjs tests/open-world-live-tile.test.mjs tests/open-world-wms.test.mjs",
    "check:tile-health": "node scripts/geospatial/tile-health-check.mjs",
    "check:mock-data": "node ../scripts/no-production-mock-data.mjs .",
    "check:parse": "node scripts/parse-check.mjs",
    "check:type": "tsc --noEmit",
    "check:integrity": "node scripts/repository-integrity-check.mjs",
    "check:geospatial": "node scripts/geospatial/validate-processing-contract.mjs",
    "check:capabilities": "node ../scripts/ci/validate-capability-registry.mjs",
    "check:workflow-boundaries": "node ../scripts/ci/validate-workflow-boundaries.mjs",
    "check:artifacts": "node ../scripts/ci/validate-artifact-manifests.mjs",
    "check:quantum-boundary": "node ../scripts/ci/validate-quantum-boundary.mjs",
    "check:shell-safety": "bash ../scripts/ci/validate-shell-safety.sh",
    "check:site-consistency": "node ../scripts/ci/validate-site-consistency.mjs",
    "check:community-engineering-boundaries": "node ../scripts/ci/validate-community-engineering-boundaries.mjs",
    "test:cinematic": "vitest run tests/cinematic-contracts.test.ts tests/cinematic-camera-tour.test.ts",
    "geospatial:fetch": "node scripts/geospatial/fetch-posey-assets.mjs",
    "geospatial:validate": "node scripts/geospatial/validate-raster-manifest.mjs",
    "check:dependency-integrity": "node scripts/dependency-integrity.mjs",
    "check:npx-policy": "node scripts/npx-policy-check.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "resync": "npm ci --no-audit --no-fund && node scripts/postinstall-check.mjs && node scripts/parse-check.mjs",
    "ci": "npm run check:production-reliability && npm run check:action-pins && npm run check:dependency-integrity && npm run check:npx-policy && npm run check:integrity && npm run check:capabilities && npm run check:workflow-boundaries && npm run check:artifacts && npm run check:quantum-boundary && npm run check:shell-safety && npm run check:site-consistency && npm run check:community-engineering-boundaries && npm run check:mock-data && npm run check:tile-health && npm run check:parse && npm run check:type && npm run check:geospatial && npm run check:government-sources && npm run check:live-fabric && npm run check:regulatory-rules && npm run check:engineering-pipeline && npm run check:schemas && npm run build && npm run check:client-bundle-secrets && npm run check:enterprise-architecture && npm run check:architecture-repository && npm run check:data-fabric-contract && npm run check:provenance-plane && npm run test:production-gates",
    "ci:full": "npm run ci && npm run test:all && npm run test:geodetic && npm run test:ingestion && npm run test:production-gates && npm run ingest",
    "check:v35.1": "tsc -p tsconfig.v35.1.json --noEmit",
    "sign:evidence": "node --experimental-strip-types ../scripts/sign-evidence.ts",
    "build:loma": "python3 ../tools/build_loma_packet.py",
    "test:v35.1": "vitest run tests/v35.1-contracts.test.ts",
    "check:schemas": "node ../scripts/ci/validate-json-schemas.mjs",
    "check:client-bundle-secrets": "node scripts/check-client-bundle-secrets.mjs",
    "test:production-gates": "node --test tests/production-gates.test.mjs",
    "check:government-sources": "node scripts/geospatial/validate-government-sources.mjs",
    "check:regulatory-rules": "node ../scripts/ci/validate-regulatory-rules.mjs",
    "check:engineering-pipeline": "node ../scripts/ci/validate-engineering-pipeline.mjs",
    "check:live-fabric": "node ../scripts/ci/validate-live-fabric.mjs",
    "check:action-pins": "node ../scripts/ci/validate-action-pins.mjs",
    "test:mapillary": "vitest run tests/mapillary-evidence-contract.test.ts",
    "test:geospatial-boundaries": "npm run test:mapillary && python3 -m unittest backend.tests.test_geospatial_contracts backend.tests.test_hec_ras_worker",
    "test:apple-maps": "vitest run tests/apple-maps-context-contract.test.ts",
    "test:data-fabrics": "vitest run tests/data-fabric-registry.test.ts server/ingestion/nws-weather.test.mjs",
    "tauri": "cargo tauri",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build",
    "desktop:check": "node scripts/desktop-updater-check.mjs",
    "check:production-reliability": "node ../scripts/ci/validate-production-reliability.mjs",
    "test:evidence-signer": "node ../scripts/evidence/test-sign-evidence.mjs",
    "test:loma-signing": "node ../scripts/evidence/test-loma-signing.mjs",
    "check:enterprise-architecture": "node ../scripts/ci/validate-enterprise-data-architecture.mjs",
    "check:architecture-repository": "node ../scripts/ci/validate-architecture-repository.mjs",
    "check:data-fabric-contract": "node ../scripts/ci/validate-data-fabric-contract.mjs",
    "check:provenance-plane": "node ../scripts/ci/validate-provenance-plane.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "6.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.1",
    "three": "^0.186.0",
    "geotiff": "^3.0.5",
    "3d-tiles-renderer": "^0.5.2",
    "h3-js": "4.5.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "@webgpu/types": "^0.1.72"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}