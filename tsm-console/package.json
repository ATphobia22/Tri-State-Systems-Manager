{
  "name": "tsm-console",
  "version": "0.2.1",
  "private": true,
  "description": "Tri-State Systems Manager — Infinite Orchestration Console",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node server/token-proxy.mjs",
    "dev:all": "node server/token-proxy.mjs & vite",
    "build": "vite build",
    "preview": "vite preview",
    "proxy": "node server/token-proxy.mjs",
    "ingest": "node -e \"import('./server/ingestion/workers.mjs').then(m => m.runHydrologicBatch().then(r => console.log(JSON.stringify(r,null,2))))\"",
    "buf:lint": "buf lint",
    "buf:gen": "buf generate",
    "buf:breaking": "buf breaking --against \".git#branch=main\"",
    "proto:all": "buf lint && buf generate",
    "postinstall": "node scripts/postinstall-check.mjs",
    "test": "node --test tests/geodetic-pipeline.test.mjs",
    "test:router": "node --test tests/router-source.test.mjs",
    "test:posey": "vitest run tests/posey-ledger.test.ts",
    "test:geodetic": "node --test tests/geodetic-pipeline.test.mjs",
    "test:firm": "node --test tests/firm-*.test.mjs",
    "test:all": "node ../tests/external-capability-integration.test.mjs && npm test && npm run test:router && npm run test:posey && npm run test:firm",
    "ingest:ras": "node scripts/ras-geotiff-ingest.mjs",
    "check:parse": "node scripts/parse-check.mjs",
    "check:type": "tsc --noEmit",
    "check:integrity": "node scripts/repository-integrity-check.mjs",
    "check:geospatial": "node scripts/geospatial/validate-processing-contract.mjs",
    "check:capabilities": "node ../scripts/ci/validate-capability-registry.mjs",
    "check:workflow-boundaries": "node ../scripts/ci/validate-workflow-boundaries.mjs",
    "check:artifacts": "node ../scripts/ci/validate-artifact-manifests.mjs",
    "check:quantum-boundary": "node ../scripts/ci/validate-quantum-boundary.mjs",
    "check:shell-safety": "bash ../scripts/ci/validate-shell-safety.sh",
    "check:site-consistency": "node ../scripts/ci/validate-site-consistency.mjs",
    "test:cinematic": "vitest run tests/cinematic-contracts.test.ts",
    "geospatial:fetch": "node scripts/geospatial/fetch-posey-assets.mjs",
    "geospatial:validate": "node scripts/geospatial/validate-raster-manifest.mjs",
    "resync": "npm ci --no-audit --no-fund && node scripts/postinstall-check.mjs && node scripts/parse-check.mjs",
    "ci": "npm run check:integrity && npm run check:capabilities && npm run check:workflow-boundaries && npm run check:artifacts && npm run check:quantum-boundary && npm run check:shell-safety && npm run check:site-consistency && npm run check:parse && npm run check:type && npm run check:geospatial && npm run build",
    "ci:full": "npm run ci && npm run test:all"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-virtual": "^3.11.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "three": "^0.170.0",
    "geotiff": "^3.0.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.0",
    "@bufbuild/protoc-gen-es": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
