{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsm.local/contracts/3d-tiles-tools-v1.schema.json",
  "title": "TSM 3D Tiles Asset Validation Contract",
  "type": "object",
  "required": ["source", "validator", "input", "result", "authorityClass"],
  "properties": {
    "source": { "const": "3d-tiles-tools" },
    "validator": { "type": "string", "minLength": 1 },
    "input": { "type": "string", "minLength": 1 },
    "result": { "enum": ["pass", "fail"] },
    "authorityClass": { "const": "DERIVED" },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
