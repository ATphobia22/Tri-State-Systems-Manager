{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tri-state-systems-manager.example/schemas/3d-asset-contract.schema.json",
  "title": "TSM 3D Geospatial Asset Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "format", "source", "source_crs", "target_crs", "vertical_datum", "toolchain", "sha256", "provenance"],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "format": {"enum": ["glTF", "GLB", "3D Tiles", "CityGML", "LAS", "LAZ"]},
    "source": {"type": "string", "minLength": 1},
    "source_crs": {"type": "string", "minLength": 1},
    "target_crs": {"type": "string", "minLength": 1},
    "vertical_datum": {"type": "string", "minLength": 1},
    "toolchain": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_reference", "generated_at"],
      "properties": {
        "source_reference": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
