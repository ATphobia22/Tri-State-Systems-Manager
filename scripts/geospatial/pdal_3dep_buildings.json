{
  "description": "Optimized EPT → ASPRS class 6 → LAZ (LazPerf). Posey AOI.",
  "pipeline": [
    {
      "type": "readers.ept",
      "filename": "https://s3-us-west-2.amazonaws.com/usgs-lidar-public/USGS_LPC_IN_WT_B12_Posey_2013_LAS_2016/ept.json",
      "bounds": "([-9791000, -9779000], [4562000, 4577000])",
      "threads": 8,
      "requests": 24,
      "ignore_unreadable": false
    },
    { "type": "filters.range", "limits": "Classification[6:6]" },
    { "type": "filters.reprojection", "out_srs": "EPSG:26916" },
    {
      "type": "writers.las",
      "filename": "data/lidar/posey_buildings.laz",
      "compression": true,
      "forward": "all"
    }
  ]
}
