{
  "description": "Optimized USGS 3DEP EPT → ground DEM. Posey AOI. requests+threads tuned; bounds mandatory; reproject 26916.",
  "pipeline": [
    {
      "type": "readers.ept",
      "filename": "https://s3-us-west-2.amazonaws.com/usgs-lidar-public/USGS_LPC_IN_WT_B12_Posey_2013_LAS_2016/ept.json",
      "bounds": "([-9791000, -9779000], [4562000, 4577000])",
      "threads": 8,
      "requests": 24,
      "ignore_unreadable": false
    },
    { "type": "filters.range", "limits": "Classification[2:2]" },
    { "type": "filters.reprojection", "out_srs": "EPSG:26916" },
    {
      "type": "writers.gdal",
      "filename": "data/dem/posey_ground_1m.tif",
      "gdaldriver": "GTiff",
      "resolution": 1.0,
      "output_type": "idw",
      "radius": 2.5,
      "nodata": -9999.0,
      "data_type": "float32"
    }
  ]
}
