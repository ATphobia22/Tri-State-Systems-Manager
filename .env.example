# TSM / UACF environment — EXAMPLE ONLY. Copy to .env and fill in real values.
# NEVER commit a real .env. All values below are placeholders.

# --- Web console (Vite) ---
VITE_TSM_API_BASE_URL=https://api.example.invalid
VITE_TSM_TERRAIN_RGB_URL_TEMPLATE=https://tiles.example.invalid/terrain/{z}/{x}/{y}.png
VITE_TSM_TERRAIN_TILE_URL=https://tiles.example.invalid/terrain/{z}/{x}/{y}.terrain
VITE_TSM_TERRAIN_RGB_ENCODING=terrarium
VITE_TSM_TERRAIN_RGB_MAXZOOM=12
VITE_TSM_TERRAIN_RGB_TILE_SIZE=256
VITE_TSM_MARTIN_BASE_URL=https://tiles.example.invalid
VITE_TSM_MARTIN_ROUTE_PREFIX=/martin
VITE_KEYCLOAK_URL=https://auth.example.invalid
VITE_IDP_AUTHORITY=https://auth.example.invalid/realms/tsm

# --- Node API / gateway ---
TSM_API_BASE_URL=https://api.example.invalid
TSM_API_BEARER_TOKEN=
CORS_ORIGIN=https://app.example.invalid
UACF_HOST=127.0.0.1
UACF_PORT=8787
UACF_CORS_ORIGIN=https://app.example.invalid
UACF_GATEWAY_URL=https://gateway.example.invalid
UACF_DASHBOARD_PORT=3001
UACF_DOCS_PORT=3002
UACF_PLAYGROUND_PORT=3003
UACF_ADMIN_PORT=
UACF_MCP_ENDPOINTS=
UACF_OPENAPI_SPEC_JSON=

# --- Data / offline bundle ---
OFFLINE_DATA_ROOT=/path/to/offline-data
DATABASE_URL=postgresql://user:password@localhost:5432/tsm

# --- Build tooling ---
TSM_DATA_OUT=/tmp/tsm-data
TSM_TERRAIN_OUTPUT_DIR=/tmp/tsm-terrain
TSM_TERRAIN_WORK_DIR=/tmp/tsm-terrain-work
TSM_TERRAIN_MIN_ZOOM=8
TSM_TERRAIN_MAX_ZOOM=12
TSM_TERRAIN_WORKERS=4
