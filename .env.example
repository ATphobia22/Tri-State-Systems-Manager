# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
DATABASE_URL=postgresql://tsm:change-me@localhost:5432/tsm
REDIS_URL=redis://localhost:6379
UACF_AUTH_MODE=development
UACF_REQUEST_TIMEOUT_MS=30000
UACF_MAX_REQUEST_BYTES=1048576

# Optional model providers. Keep credentials in a secret manager in deployed environments.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Tri-State Systems Manager
