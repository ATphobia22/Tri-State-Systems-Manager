# TSM Oracle deployment — login-free, gauge-independent runtime.
# Copy to .env for manual deployment. Never commit a populated .env.

API_HOSTNAME=api.203-0-113-51.sslip.io
SOURCE_COMMIT=local
TSM_PUBLIC_OPERATOR_MODE=1
TSM_OFFLINE=0
CORS_ORIGIN=https://api.203-0-113-51.sslip.io

# Generate locally with: openssl rand -base64 48
TSM_SESSION_SECRET=CHANGE_ME_GENERATED_SECRET
UACF_MASTER_KEY=CHANGE_ME_GENERATED_SECRET

# Optional provider credentials. Leave empty for deterministic/local-only mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FIRECRAWL_API_KEY=
