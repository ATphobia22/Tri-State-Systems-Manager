# TSM Oracle deployment — copy to `.env` and fill in. Never commit `.env`.
#
# Hostnames: no domain? Use sslip.io with your VM's public IPv4.
# Example: VM public IP 203.0.113.51  ->  api.203-0-113-51.sslip.io
# (dots become dashes). Upgrade to a real domain later by changing these
# two lines and redeploying.

# === Public HTTPS hostnames ===
API_HOSTNAME=api.203-0-113-51.sslip.io
KEYCLOAK_HOSTNAME=keycloak.203-0-113-51.sslip.io

# === Deploy identity ===
# Exact git SHA the API reports at GET /ready. The GitHub deploy workflow
# sets this automatically on every deploy; the Pages gate requires it to
# equal GITHUB_SHA. Leave as-is for manual deploys and pass it on the
# command line instead:  SOURCE_COMMIT=<sha> docker compose up -d --build
SOURCE_COMMIT=local

# === Keycloak bootstrap admin (API also uses these to create the tsm realm) ===
KEYCLOAK_ADMIN_USERNAME=tsm-admin
# Generate with:  openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# === API -> Keycloak wiring ===
# Issuer MUST be the public Keycloak hostname + /realms/tsm
OIDC_ISSUER=https://keycloak.203-0-113-51.sslip.io/realms/tsm
OIDC_AUDIENCE=tsm-console-api
OIDC_CLIENT_ID=tsm-console-bff
# Generate with:  openssl rand -base64 32
OIDC_CLIENT_SECRET=CHANGE_ME
# The API serves its OIDC callback at /api/auth/callback
OIDC_REDIRECT_URI=https://api.203-0-113-51.sslip.io/api/auth/callback
OIDC_SCOPES=openid profile email roles

# === API sessions / CORS ===
# Generate with:  openssl rand -base64 48   (minimum 32 characters)
TSM_SESSION_SECRET=CHANGE_ME
# The GitHub Pages frontend origin
CORS_ORIGIN=https://atphobia22.github.io

# === PostgreSQL (Keycloak's database) ===
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
# Generate with:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME
