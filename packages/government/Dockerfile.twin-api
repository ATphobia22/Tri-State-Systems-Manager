# Lean optional geospatial read API; independent of the offline Windows executable.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --system tsm && useradd --system --gid tsm --home /app tsm
RUN pip install --no-cache-dir "fastapi>=0.115,<1" "uvicorn>=0.30,<1" "psycopg2-binary>=2.9,<3"
COPY backend/__init__.py /app/backend/__init__.py
COPY backend/api/__init__.py /app/backend/api/__init__.py
COPY backend/api/v1/__init__.py /app/backend/api/v1/__init__.py
COPY backend/api/v1/regional_twin.py /app/backend/api/v1/regional_twin.py
COPY backend/geospatial/__init__.py /app/backend/geospatial/__init__.py
COPY backend/geospatial/twin_server.py /app/backend/geospatial/twin_server.py
USER tsm
EXPOSE 8769
CMD ["uvicorn","backend.geospatial.twin_server:app","--host","0.0.0.0","--port","8769"]
