{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsm:schemas:cesium-story-publication-manifest:v1",
  "title": "TSMCesiumStoryPublicationManifest",
  "description": "Provenance and review record for an optional external Cesium ion Story export. This manifest is not a Cesium ion API payload and must never contain credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationId",
    "createdAt",
    "dataset",
    "exportedArtifacts",
    "review",
    "presentation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "publicationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "version",
        "sourceAuthority",
        "sourceUrl",
        "retrievedAt",
        "sha256",
        "horizontalCrs",
        "classification"
      ],
      "properties": {
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceAuthority": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "horizontalCrs": {
          "type": "string",
          "minLength": 1
        },
        "verticalDatum": {
          "type": "string",
          "minLength": 1
        },
        "verticalUnits": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "public",
            "approved_public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exportedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mediaType",
          "sha256",
          "byteLength",
          "role",
          "redactionReviewed"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "terrain",
              "imagery",
              "buildings",
              "observed",
              "derived",
              "simulated",
              "scenario",
              "regulatory_context",
              "narrative",
              "other"
            ]
          },
          "redactionReviewed": {
            "const": true
          }
        }
      }
    },
    "modelRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "modelName",
        "modelVersion",
        "configurationSha256",
        "inputManifestSha256",
        "validationStatus"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "modelName": {
          "type": "string",
          "minLength": 1
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "configurationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "inputManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "validationStatus": {
          "enum": [
            "not_run",
            "pending",
            "passed",
            "failed",
            "review_required"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationDecision",
        "dataLicenseReviewed",
        "sensitiveDataReviewed",
        "propertyAllowlistReviewed",
        "reviewNotes"
      ],
      "properties": {
        "publicationDecision": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "dataLicenseReviewed": {
          "type": "boolean"
        },
        "sensitiveDataReviewed": {
          "type": "boolean"
        },
        "propertyAllowlistReviewed": {
          "type": "boolean"
        },
        "reviewNotes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publicationDecision": {
                "const": "approved"
              }
            },
            "required": [
              "publicationDecision"
            ]
          },
          "then": {
            "required": [
              "approver",
              "approvedAt"
            ],
            "properties": {
              "dataLicenseReviewed": {
                "const": true
              },
              "sensitiveDataReviewed": {
                "const": true
              },
              "propertyAllowlistReviewed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "externalSharingEnabled"
      ],
      "properties": {
        "provider": {
          "const": "cesium-ion-stories"
        },
        "storyUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "externalSharingEnabled": {
          "type": "boolean"
        },
        "embedEnabled": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "externalSharingEnabled": {
                "const": true
              }
            },
            "required": [
              "externalSharingEnabled"
            ]
          },
          "then": {
            "required": [
              "storyUrl"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "presentation": {
            "properties": {
              "externalSharingEnabled": {
                "const": true
              }
            },
            "required": [
              "externalSharingEnabled"
            ]
          }
        },
        "required": [
          "presentation"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "publicationDecision": {
                "const": "approved"
              },
              "dataLicenseReviewed": {
                "const": true
              },
              "sensitiveDataReviewed": {
                "const": true
              },
              "propertyAllowlistReviewed": {
                "const": true
              }
            },
            "required": [
              "publicationDecision",
              "dataLicenseReviewed",
              "sensitiveDataReviewed",
              "propertyAllowlistReviewed"
            ]
          }
        },
        "required": [
          "review"
        ]
      }
    }
  ]
}
