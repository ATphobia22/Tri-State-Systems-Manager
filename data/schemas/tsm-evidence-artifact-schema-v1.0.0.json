{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tsm-community.example/schemas/evidence-artifact/v1.0.0.json",
  "title": "TSM EvidenceArtifact",
  "description": "Canonical artifact for Evidence & Data Governance Plane. AUTHORITY→OBSERVATION→DERIVATION→MODEL→INFERENCE→VISUALIZATION must not be collapsed. SHA-256 proves integrity only.",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "source_authority",
    "source_uri",
    "retrieved_at",
    "spatial_reference",
    "vertical_reference",
    "content_hash_sha256",
    "parent_artifacts",
    "transformation_chain",
    "validation_status",
    "authority_class",
    "derivation_class",
    "governance_status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "source_authority": {
      "type": "string"
    },
    "source_uri": {
      "type": "string",
      "format": "uri"
    },
    "source_identifier": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "spatial_reference": {
      "type": "object",
      "required": [
        "horizontal_crs"
      ],
      "properties": {
        "horizontal_crs": {
          "type": "string",
          "description": "e.g. EPSG:2966 — never conflate with vertical datum"
        },
        "horizontal_crs_name": {
          "type": "string"
        },
        "units": {
          "type": "string"
        }
      }
    },
    "vertical_reference": {
      "type": "object",
      "required": [
        "vertical_datum"
      ],
      "properties": {
        "vertical_datum": {
          "type": "string",
          "description": "e.g. NAVD88"
        },
        "units": {
          "type": "string"
        }
      }
    },
    "source_version": {
      "type": "string"
    },
    "content_hash_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transformation_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "operation",
          "from",
          "to"
        ],
        "properties": {
          "step": {
            "type": "integer"
          },
          "operation": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "software": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "pending",
        "validated",
        "rejected",
        "stale",
        "provisional",
        "failed_closed"
      ]
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "OBSERVATION",
        "FORECAST",
        "REGULATORY",
        "DERIVED",
        "MODEL_OUTPUT",
        "INFERENCE",
        "VISUALIZATION",
        "SIMULATION_DEMO"
      ]
    },
    "derivation_class": {
      "type": "string",
      "enum": [
        "RAW",
        "TRANSFORMED",
        "AGGREGATED",
        "MODELED",
        "INFERRED",
        "RENDERED"
      ]
    },
    "model_version": {
      "type": "string"
    },
    "software_version": {
      "type": "string"
    },
    "operator_or_service_identity": {
      "type": "string"
    },
    "governance_status": {
      "type": "string",
      "enum": [
        "draft",
        "human_review_required",
        "human_authorized",
        "published",
        "superseded",
        "withdrawn"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_simulation_demo": {
      "type": "boolean"
    },
    "human_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "signed"
      ],
      "description": "Controlled review states matching values already used across the repo: 'pending' (created, not yet reviewed), 'approved'/'rejected' (reviewer decision, cf. HEC-RAS contracts), 'signed' (human authorization transition completed). Values are lowercase to match validation_status/governance_status conventions."
    },
    "daubert_factors": {
      "type": "object",
      "description": "Optional descriptive fields recording Daubert-factor considerations for an evidence artifact. These are free-text annotations to support human review; they are never a claim of legal compliance or admissibility. FRE 702 admissibility is a judicial determination, not a schema boolean.",
      "properties": {
        "testability": {
          "type": "string",
          "description": "Description of whether and how the method producing this artifact can be or has been tested."
        },
        "peer_review": {
          "type": "string",
          "description": "Description of any peer review or publication relevant to the method."
        },
        "known_error_rate": {
          "type": "string",
          "description": "Description of known or estimated error rates and how they were determined."
        },
        "standards": {
          "type": "string",
          "description": "Description of standards or procedures controlling the method's operation."
        },
        "general_acceptance": {
          "type": "string",
          "description": "Description of the method's general acceptance in the relevant community."
        }
      },
      "additionalProperties": false
    },
    "inclusion_proof": {
      "type": "object",
      "description": "Optional Merkle inclusion proof binding this artifact to an inclusion tree. Optional so existing artifacts without proofs still validate. Presence of a proof asserts integrity (membership in a tree) only — never correctness, accuracy, or compliance.",
      "required": [
        "merkle_root",
        "leaf_index",
        "proof_path"
      ],
      "properties": {
        "merkle_root": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase-no-prefix SHA-256 root of the inclusion tree."
        },
        "leaf_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based index of this artifact's leaf in the tree."
        },
        "proof_path": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]+$",
            "description": "Sibling hashes along the path from leaf to root, each lowercase hex."
          },
          "description": "Ordered sibling hashes from leaf to root."
        },
        "tree_algorithm": {
          "type": "string",
          "description": "Algorithm used to build the tree, e.g. \"TSM-Merkle-WebCrypto-SHA256\"."
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "human_authorization": {
      "type": "object",
      "description": "Present only after the server-side human authorization transition. SHA-256 reviewed_artifact_hash binds the review to the exact raw artifact; this object is an authorization record, not a digital signature.",
      "required": [
        "reviewer_identity",
        "review_reason",
        "reviewed_at",
        "reviewed_artifact_hash"
      ],
      "properties": {
        "reviewer_identity": {
          "type": "string",
          "minLength": 1
        },
        "review_reason": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_artifact_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
