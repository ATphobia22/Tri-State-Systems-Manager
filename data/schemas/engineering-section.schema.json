{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.tsm-community.example/schemas/engineering-section/v1.0.0.json",
  "title":"TSM Subsurface-to-Finished-Grade Engineering Section",
