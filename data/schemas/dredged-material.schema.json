{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tsm-community.example/schemas/dredged-material/v1.0.0.json",
  "title": "TSM Dredged Material Qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material_id",
    "source_dredging_project",
    "dredging_campaign",
    "grain_size_distribution",
    "moisture_content",
    "compaction_characteristics",
    "shear_strength",
    "consolidation",
    "environmental_testing",
    "chain_of_custody",
    "review_state"
  ],
  "properties": {
    "material_id": {"type":"string","minLength":1},
    "source_dredging_project": {"type":"string","minLength":1},
    "channel_reach": {"type":"string","minLength":1},
    "dredging_campaign": {
      "type":"object",
      "additionalProperties": false,
      "required":["start_date","end_date"],
      "properties": {
        "start_date":{"type":"string","format":"date"},
        "end_date":{"type":"string","format":"date"}
      }
    },
    "sample_locations": {"type":"array","items":{"type":"string"}},
    "grain_size_distribution": {"type":"object","additionalProperties":true},
    "moisture_content": {"type":"object","additionalProperties":true},
    "atterberg_limits": {"type":["object","null"],"additionalProperties":true},
    "organic_content": {"type":["object","null"],"additionalProperties":true},
    "specific_gravity_bulk_density": {"type":"object","additionalProperties":true},
    "compaction_characteristics": {"type":"object","additionalProperties":true},
    "shear_strength": {"type":"object","additionalProperties":true},
    "hydraulic_conductivity": {"type":["object","null"],"additionalProperties":true},
    "consolidation": {"type":"object","additionalProperties":true},
    "settlement_characteristics": {"type":"object","additionalProperties":true},
    "environmental_testing": {"type":"object","additionalProperties":true},
    "leachability": {"type":["object","null"],"additionalProperties":true},
    "dewatering_requirements": {"type":["object","null"],"additionalProperties":true},
    "processing_or_blending": {"type":["object","null"],"additionalProperties":true},
    "laboratory_provenance": {
      "type":"object",
      "additionalProperties":false,
      "required":["laboratory","method_version"],
      "properties": {
        "laboratory":{"type":"string","minLength":1},
        "method_version":{"type":"string","minLength":1},
        "report_id":{"type":"string"}
      }
    },
    "chain_of_custody": {
      "type":"object",
      "additionalProperties":false,
      "required":["sample_ids","custody_events"],
      "properties": {
        "sample_ids":{"type":"array","items":{"type":"string"}},
        "custody_events":{"type":"array","items":{"type":"object","additionalProperties":true}}
      }
    },
    "proposed_use": {"type":"string","enum":["structural_fill","road_fill","berm_fill","habitat","wetland_restoration","upland_placement","other"]},
    "review_state": {"type":"string","enum":["UNASSESSED","TESTING_REQUIRED","REJECTED","CONDITIONALLY_ACCEPTED","ACCEPTED_FOR_SPECIFIC_USE","ENGINEERING_REVIEW_READY"]},
    "reviewer_role": {"type":["string","null"]},
    "evidence_ids": {"type":"array","items":{"type":"string"}}
  }
}
