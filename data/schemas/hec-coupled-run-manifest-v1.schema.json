{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsm:hec-coupled-run-manifest:v1",
  "title": "TSM Coupled HEC-HMS to HEC-RAS Run Manifest",
  "description": "Reproducible, fail-closed model execution contract. DRAFT manifests are structurally valid but cannot execute; the runner requires approval.status=APPROVED and approval.evidence_uri plus exact AOI and datum provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "purpose",
    "approval",
    "aoi",
    "reference_system",
    "source_inputs",
    "hec_hms",
    "hydrograph_handoff",
    "hec_ras",
    "artifact_storage"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "purpose": {
      "enum": [
        "OBSERVED_EVENT_RECONSTRUCTION",
        "FORECAST_SCENARIO",
        "DESIGN_STORM",
        "BASELINE",
        "ALTERNATIVE_SCENARIO",
        "BENCHMARK_ONLY"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "evidence_uri"
      ],
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "REVOKED"
          ]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_uri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aoi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "geometry_uri",
        "geometry_sha256",
        "area_km2",
        "watershed_delineation_uri",
        "watershed_delineation_sha256",
        "geometry_workspace_path",
        "watershed_delineation_workspace_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "geometry_uri": {
          "type": "string",
          "minLength": 1
        },
        "geometry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "area_km2": {
          "type": "number",
          "minimum": 0.000001
        },
        "watershed_delineation_uri": {
          "type": "string",
          "minLength": 1
        },
        "watershed_delineation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "geometry_workspace_path": {
          "type": "string",
          "minLength": 1
        },
        "watershed_delineation_workspace_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizontal_crs",
        "vertical_datum",
        "units_policy",
        "datum_evidence_uri"
      ],
      "properties": {
        "horizontal_crs": {
          "type": "string",
          "minLength": 1
        },
        "vertical_datum": {
          "type": "string",
          "minLength": 1
        },
        "units_policy": {
          "type": "string",
          "minLength": 1
        },
        "datum_evidence_uri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "authority_class",
          "source_uri",
          "retrieved_at",
          "valid_time",
          "sha256",
          "media_type",
          "units",
          "horizontal_crs",
          "vertical_datum",
          "quality_status",
          "license_or_terms_uri",
          "workspace_path"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1
          },
          "authority_class": {
            "enum": [
              "OBSERVED",
              "FORECAST",
              "DERIVED",
              "MODELLED",
              "SCENARIO",
              "REGULATORY",
              "PROJECT_ENGINEERING"
            ]
          },
          "source_uri": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_time": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "horizontal_crs": {
            "type": "string",
            "minLength": 1
          },
          "vertical_datum": {
            "type": "string",
            "minLength": 1
          },
          "quality_status": {
            "enum": [
              "QUALIFIED",
              "PROVISIONAL",
              "STALE",
              "MISSING",
              "REJECTED"
            ]
          },
          "license_or_terms_uri": {
            "type": "string",
            "minLength": 1
          },
          "workspace_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hec_hms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_version",
        "platform",
        "project_directory",
        "command",
        "timeout_seconds",
        "expected_outputs",
        "output_directory",
        "working_directory",
        "project_package_sha256",
        "executable_sha256",
        "version_evidence_uri"
      ],
      "properties": {
        "product_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "windows-x64",
            "linux-x64",
            "macos-arm64",
            "other"
          ]
        },
        "project_directory": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1,
          "description": "Isolated workspace clone used for execution; source project remains immutable."
        },
        "project_package_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Measured SHA-256 of the immutable input project tree."
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Measured SHA-256 of command[0], the pinned execution adapter."
        },
        "version_evidence_uri": {
          "type": "string",
          "minLength": 1,
          "description": "Evidence reference for the exact installed HEC product version and platform."
        }
      }
    },
    "hydrograph_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_output",
        "ras_input",
        "format",
        "time_zone",
        "flow_units",
        "gap_policy",
        "conversion_method",
        "source_flow_units",
        "source_dss_pathname",
        "ras_dss_pathname",
        "boundary_file_path",
        "handoff_receipt_path",
        "expected_interval_seconds",
        "negative_flow_policy",
        "interpolation_method",
        "boundary_selector",
        "adapter_command",
        "adapter_version",
        "adapter_executable_sha256",
        "timeout_seconds"
      ],
      "properties": {
        "source_output": {
          "type": "string",
          "minLength": 1
        },
        "ras_input": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "DSS",
            "CSV",
            "OTHER_DOCUMENTED"
          ]
        },
        "time_zone": {
          "type": "string",
          "minLength": 1
        },
        "flow_units": {
          "enum": [
            "cfs",
            "cms",
            "OTHER_DOCUMENTED"
          ]
        },
        "gap_policy": {
          "enum": [
            "REJECT",
            "EXPLICITLY_DOCUMENTED_INTERPOLATION"
          ]
        },
        "conversion_method": {
          "type": "string",
          "minLength": 1
        },
        "source_flow_units": {
          "enum": [
            "cfs",
            "cms",
            "OTHER_DOCUMENTED"
          ]
        },
        "source_dss_pathname": {
          "type": "string",
          "minLength": 7,
          "description": "Exact source HEC-DSS pathname selected from the HEC-HMS run output catalog."
        },
        "ras_dss_pathname": {
          "type": "string",
          "minLength": 7,
          "description": "Exact target HEC-DSS pathname written and verified in RAS DSS catalog."
        },
        "boundary_file_path": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace-relative .u## file in the isolated HEC-RAS working directory that receives the boundary update."
        },
        "handoff_receipt_path": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace-relative JSON receipt written by the pinned adapter and verified by TSM."
        },
        "expected_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "negative_flow_policy": {
          "enum": [
            "REJECT",
            "ALLOW_WITH_APPROVAL"
          ]
        },
        "interpolation_method": {
          "type": "string",
          "minLength": 1,
          "description": "Must identify the actual interpolation method when documented gap-filling is enabled; otherwise use NOT_APPLICABLE."
        },
        "boundary_selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expected_bc_type"
          ],
          "properties": {
            "kind": {
              "enum": [
                "1D",
                "2D"
              ]
            },
            "river": {
              "type": "string",
              "minLength": 1
            },
            "reach": {
              "type": "string",
              "minLength": 1
            },
            "station": {
              "type": "string",
              "minLength": 1
            },
            "area_2d": {
              "type": "string",
              "minLength": 1
            },
            "bc_line": {
              "type": "string",
              "minLength": 1
            },
            "boundary_index": {
              "type": "integer",
              "minimum": 0
            },
            "expected_bc_type": {
              "enum": [
                "Flow Hydrograph",
                "Lateral Inflow Hydrograph",
                "Uniform Lateral Inflow"
              ]
            }
          }
        },
        "adapter_command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Pinned shell-free adapter argv. Supported tokens: {{workspace}}, {{project}}, {{output}}, {{source_output}}, {{ras_input}}, {{boundary_file}}, {{receipt}}, {{manifest}}."
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "description": "Exact transfer-adapter package version or immutable commit."
        },
        "adapter_executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "hec_ras": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_version",
        "platform",
        "project_directory",
        "command",
        "timeout_seconds",
        "expected_outputs",
        "output_directory",
        "working_directory",
        "project_package_sha256",
        "executable_sha256",
        "version_evidence_uri"
      ],
      "properties": {
        "product_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "windows-x64",
            "linux-x64",
            "macos-arm64",
            "other"
          ]
        },
        "project_directory": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1,
          "description": "Isolated workspace clone used for execution; source project remains immutable."
        },
        "project_package_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Measured SHA-256 of the immutable input project tree."
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Measured SHA-256 of command[0], the pinned execution adapter."
        },
        "version_evidence_uri": {
          "type": "string",
          "minLength": 1,
          "description": "Evidence reference for the exact installed HEC product version and platform."
        }
      }
    },
    "artifact_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "root_directory",
        "retention_policy",
        "metadata_store"
      ],
      "properties": {
        "backend": {
          "const": "filesystem-content-addressed"
        },
        "root_directory": {
          "type": "string",
          "minLength": 1
        },
        "retention_policy": {
          "type": "string",
          "minLength": 1
        },
        "metadata_store": {
          "enum": [
            "run-manifest-only",
            "tsm-evidence-store-adapter"
          ]
        }
      }
    }
  }
}
