              "type": "string",
              "title": "Fips"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Catalog County Api Catalog County  Fips  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/regional": {
      "get": {
        "summary": "Catalog Regional",
        "description": "List regional (multi-county) datasets.",
        "operationId": "catalog_regional_api_catalog_regional_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Catalog Regional Api Catalog Regional Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/geospatial/county/{fips}/parcels": {
      "get": {
        "summary": "County Parcels",
        "description": "Serve a county's parcel GeoJSON. Use ?limit=N to cap features.",
        "operationId": "county_parcels_api_geospatial_county__fips__parcels_get",
        "parameters": [
          {
            "name": "fips",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Fips"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 0,
              "default": 0,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response County Parcels Api Geospatial County  Fips  Parcels Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/geospatial/county/{fips}/floodplain": {
      "get": {
        "summary": "County Floodplain",
        "description": "Serve a county's flood-zone GeoJSON. Use ?limit=N to cap features.",
        "operationId": "county_floodplain_api_geospatial_county__fips__floodplain_get",
        "parameters": [
          {
            "name": "fips",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Fips"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
