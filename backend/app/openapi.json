              "type": "integer",
              "maximum": 5000,
              "minimum": 0,
              "default": 0,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response County Floodplain Api Geospatial County  Fips  Floodplain Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactRef": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "sha256": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "name",
          "sha256"
        ],
        "title": "ArtifactRef"
      },
      "EvidenceLockRequest": {
        "properties": {
          "lag_navd88": {
            "type": "number",
            "maximum": 450.0,
            "minimum": 300.0,
            "title": "Lag Navd88"
          },
          "bfe_navd88": {
            "type": "number",
            "maximum": 450.0,
            "minimum": 300.0,
            "title": "Bfe Navd88"
          },
          "panel_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Panel Number"
          },
          "human_authorized": {
            "type": "boolean",
            "title": "Human Authorized",
            "default": false
          },
          "reviewer_identity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Identity"
          },
          "review_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lag_navd88",
          "bfe_navd88"
        ],
        "title": "EvidenceLockRequest"
      },
      "EvidenceLockResponse": {
        "properties": {
          "artifact_schema": {
            "type": "string",
            "title": "Artifact Schema"
          },
          "timestamp_epoch": {
            "type": "integer",
            "title": "Timestamp Epoch"
          },
          "immutable_hash": {
            "type": "string",
            "title": "Immutable Hash"
          },
          "freeboard_ft": {
            "type": "number",
            "title": "Freeboard Ft"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "human_authorized": {
            "type": "boolean",
            "title": "Human Authorized"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifact_schema",
          "timestamp_epoch",
          "immutable_hash",
          "freeboard_ft",
          "status",
          "human_authorized",
          "payload"
        ],
        "title": "EvidenceLockResponse"
      },
      "EvidencePacket": {
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "title": "Case Id"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactRef"
            },
            "type": "array",
            "minItems": 1,
            "title": "Artifacts"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "case_id",
          "artifacts"
        ],
        "title": "EvidencePacket"
      },
      "EvidencePushRequest": {
        "properties": {
          "packet": {
            "$ref": "#/components/schemas/EvidencePacket"
          },
          "packet_sha256": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Packet Sha256"
          }
        },
        "type": "object",
        "required": [
          "packet",
          "packet_sha256"
        ],
        "title": "EvidencePushRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LedgerAppendRequest": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Artifact Id"
          },
          "human_authorization": {
            "$ref": "#/components/schemas/LedgerAuthorization"
          }
        },
        "type": "object",
        "required": [
          "artifact_id",
          "human_authorization"
        ],
        "title": "LedgerAppendRequest"
      },
      "LedgerAuthorization": {
        "properties": {
          "reviewer_identity": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Reviewer Identity"
          },
          "authorization_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Authorization Id"
          },
          "authorized_at": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Authorized At"
          },
          "reason": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reviewer_identity",
          "authorization_id",
          "authorized_at",
          "reason"
        ],
        "title": "LedgerAuthorization"
      },
      "RasCell": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Id"
          },
          "x_native": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "X Native"
          },
          "y_native": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Y Native"
          },
          "lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "depth_ft": {
            "type": "number",
            "minimum": 0.0,
            "title": "Depth Ft"
          },
          "wse_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wse Ft"
          }
        },
        "type": "object",
        "required": [
          "id",
          "depth_ft"
        ],
        "title": "RasCell"
      },
      "RasMeta": {
        "properties": {
          "plan_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Plan Id"
          },
          "source": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Source",
            "default": "geotiff:unknown"
          },
          "content_hash_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "title": "Content Hash Sha256"
          },
          "authority_class": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Authority Class"
          },
          "derivation_class": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Derivation Class",
            "default": "HEC_RAS_DEPTH_DOWNSAMPLE"
          },
          "model_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Note"
          },
          "horizontal_crs_note": {
            "anyOf": [
              {
                "type": "string",
