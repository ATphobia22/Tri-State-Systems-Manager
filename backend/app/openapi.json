{
  "openapi": "3.1.0",
  "info": {
    "title": "TSM Companion API",
    "description": "Provisional intake only. This service does not submit, issue, or approve anything with FEMA or any agency. Human authority remains final; every accepted artifact requires human review.",
    "version": "1.0.0"
  },
  "paths": {
    "/evidence/lock-packet": {
      "post": {
        "tags": [
          "evidence-lock"
        ],
        "summary": "Create Lock Packet",
        "operationId": "create_lock_packet_evidence_lock_packet_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceLockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceLockResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/geospatial/posey/manifest": {
      "get": {
        "summary": "Posey Manifest",
        "description": "Return the immutable registered Posey 2020 asset manifest.",
        "operationId": "posey_manifest_api_geospatial_posey_manifest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Posey Manifest Api Geospatial Posey Manifest Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/geospatial/posey/raster": {
      "get": {
        "summary": "Posey Raster",
        "description": "Stream a bounded Posey terrain/orthophoto raster from an allowlisted source.",
        "operationId": "posey_raster_api_geospatial_posey_raster_get",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Bbox"
            }
          },
          {
            "name": "width",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1024,
              "title": "Width"
            }
          },
          {
            "name": "height",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1024,
              "title": "Height"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "terrain",
              "title": "Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/engineering/ras-results": {
      "post": {
        "summary": "Ingest Ras Results",
        "description": "Validate and persist operator-supplied HEC-RAS model-output evidence.",
        "operationId": "ingest_ras_results_api_engineering_ras_results_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RasResultsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ingest Ras Results Api Engineering Ras Results Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ledger/append": {
      "post": {
        "summary": "Ledger Append",
        "description": "Append a model/evidence artifact to the local audit ledger only after human authorization.",
        "operationId": "ledger_append_api_ledger_append_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerAppendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ledger Append Api Ledger Append Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/evidence/push": {
      "post": {
        "summary": "Push Evidence",
        "description": "Accept an evidence packet into the local outbox.\n\nValidates the packet SHA-256 against the canonical (sort_keys) JSON of the\npacket body. 422 fail-closed on any mismatch or schema violation. The\nresponse is a signed receipt of INTAKE ONLY \u2014 it never claims FEMA\nsubmission, acceptance, or approval.",
        "operationId": "push_evidence_api_evidence_push_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidencePushRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Push Evidence Api Evidence Push Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/geospatial/posey/parcels": {
      "get": {
        "summary": "Posey Parcel Geometry",
        "description": "Serve verified public Posey parcel geometry with WTH record provenance.",
        "operationId": "posey_parcel_geometry_api_geospatial_posey_parcels_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Posey Parcel Geometry Api Geospatial Posey Parcels Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/hydrologic/posey/openmi-wse": {
      "get": {
        "summary": "Posey Openmi Wse",
        "description": "Expose one current USGS-derived WSE observation as an OpenMI-compatible envelope.",
        "operationId": "posey_openmi_wse_api_hydrologic_posey_openmi_wse_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Posey Openmi Wse Api Hydrologic Posey Openmi Wse Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/hydrologic/nodes": {
      "get": {
        "summary": "Hydrologic Nodes",
        "description": "Serve the USACE hydrologic node registry example.\n\nRead-only. Null numerics mean 'not published by the authority' and must\nnever be interpolated or converted downstream.",
        "operationId": "hydrologic_nodes_api_hydrologic_nodes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Hydrologic Nodes Api Hydrologic Nodes Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/hydrologic/snapshot/stations": {
      "get": {
        "summary": "Hydrologic Snapshot Stations",
        "description": "Static registry behind the snapshot button. No live data here.",
        "operationId": "hydrologic_snapshot_stations_api_hydrologic_snapshot_stations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Hydrologic Snapshot Stations Api Hydrologic Snapshot Stations Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/hydrologic/snapshot": {
      "post": {
        "summary": "Hydrologic Snapshot",
        "description": "Fetch a one-time live snapshot of all registry gauges.\n\nUser-initiated only: this route performs no polling, keeps no schedule,\nand persists nothing. Values are USGS instantaneous observations as of\nthe fetch moment, marked provisional. Stations the upstream service does\nnot return are reported unavailable \u2014 never invented.",
        "operationId": "hydrologic_snapshot_api_hydrologic_snapshot_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Hydrologic Snapshot Api Hydrologic Snapshot Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/gauge-ingest": {
      "post": {
        "summary": "Gauge Ingest",
        "description": "Accept gauge readings into quarantine.\n\nEvery reading is provenance-hashed and written to the quarantine dir.\nNothing here is authoritative: human_review_required is always true.\n\nThe request body is streamed with a hard byte cap (413 on exceed) so a\nsingle webhook call cannot force unbounded disk writes.",
        "operationId": "gauge_ingest_api_webhooks_gauge_ingest_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Gauge Ingest Api Webhooks Gauge Ingest Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/counties": {
      "get": {
        "summary": "Catalog Counties",
        "description": "List the 8 tri-state counties with dataset availability.",
        "operationId": "catalog_counties_api_catalog_counties_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Catalog Counties Api Catalog Counties Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/county/{fips}": {
      "get": {
        "summary": "Catalog County",
        "description": "Detailed file listing for one county.",
        "operationId": "catalog_county_api_catalog_county__fips__get",
        "parameters": [
          {
            "name": "fips",
            "in": "path",
            "required": true,
