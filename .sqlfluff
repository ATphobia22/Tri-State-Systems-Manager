[sqlfluff]
dialect = postgres
max_line_length = 80
exclude_rules = LT01,LT02,LT05,CP01,CP02,CP03,CP05,RF04

# These migrations use the repository's established PostgreSQL DDL style.
# Layout/capitalisation rules are intentionally excluded so linting remains
# focused on parsing and substantive SQL correctness without rewriting stable
# identifiers or function names.
