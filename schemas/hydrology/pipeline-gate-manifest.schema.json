{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsm.example/schemas/hydrology/pipeline-gate-manifest.schema.json",
  "title": "TSM Evidence-Gated Hydrology Pipeline Manifest",
  "description": "Structural contract only. Passing this schema does not verify evidence authenticity or authorize model execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pipeline_execution_id", "aoi_target_id", "gate_version", "gates"],
  "properties": {
    "pipeline_execution_id": {"type": "string", "minLength": 1},
    "aoi_target_id": {"type": "string", "minLength": 1},
    "gate_version": {"type": "string", "minLength": 1},
    "daubert_compliance_strict": {"type": "boolean"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "01_TERRAIN_DATA_QUALITY_GATE",
        "02_JURISDICTION_SOURCE_GATE",
        "03_OUTLET_EVIDENCE_GATE",
        "04_DOWNSTREAM_MODEL_GATE"
      ],
      "properties": {
        "01_TERRAIN_DATA_QUALITY_GATE": {"$ref": "#/$defs/upstreamGate"},
        "02_JURISDICTION_SOURCE_GATE": {"$ref": "#/$defs/upstreamGate"},
        "03_OUTLET_EVIDENCE_GATE": {"$ref": "#/$defs/upstreamGate"},
        "04_DOWNSTREAM_MODEL_GATE": {
          "type": "object",
          "required": ["status", "dependencies", "execution_blocked"],
          "properties": {
            "status": {"enum": ["BLOCKED", "READY_FOR_REVIEW", "READY_FOR_EXECUTION"]},
            "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "execution_blocked": {"const": true},
            "approval": {
              "type": "object",
              "required": ["approved", "approver_id", "approved_scope_hash"],
              "properties": {
                "approved": {"type": "boolean"},
                "approver_id": {"type": "string", "minLength": 1},
                "approved_scope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source_id", "artifact_uri", "sha256", "verified"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "artifact_uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified": {"const": true},
        "retrieved_at_utc": {"type": "string", "format": "date-time"},
        "source_version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "upstreamGate": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["BLOCKED", "FAILED", "PASSED"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": true
    }
  }
}
