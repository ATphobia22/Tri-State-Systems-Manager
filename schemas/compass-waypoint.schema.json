{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsm:schemas:compass-waypoint:1.0.0",
  "title": "TSM Compass Waypoint",
  "description": "A candidate field waypoint recorded from a device compass or entered coordinates. Not survey-grade evidence by default. Source coordinate/datum combinations are validated operationally using pyproj; schema validation alone does not establish positional accuracy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "coordinates",
    "coordinateReferenceSystem",
    "source",
    "recordedAt",
    "reviewStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "symbol": {
      "type": "string",
      "maxLength": 64
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation": {
          "type": [
            "number",
            "null"
          ]
        },
        "elevationUnit": {
          "enum": [
            "m",
            "ft",
            "ftUS",
            null
          ],
          "description": "Explicit height unit, US survey foot and international foot are distinct."
        },
        "verticalDatum": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NAVD88",
            "NGVD29",
            "ELLIPSOIDAL_NAD83_2011",
            "ELLIPSOIDAL_WGS84",
            null
          ],
          "description": "Source vertical datum only; legacy and ellipsoidal heights require an independently verified NAVD88 transformation before elevation ingest."
        },
        "horizontalAccuracyMeters": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "elevation": {
                "type": "number"
              }
            },
            "required": [
              "elevation"
            ]
          },
          "then": {
            "required": [
              "verticalDatum",
              "elevationUnit"
            ],
            "properties": {
              "verticalDatum": {
                "type": "string"
              },
              "elevationUnit": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "coordinateReferenceSystem": {
      "type": "string",
      "enum": [
        "EPSG:4326",
        "OGC:CRS84"
      ],
      "description": "Coordinates keys are geographic latitude/longitude degrees; EPSG:2966 projected US-survey-foot eastings/northings must use a distinct projected payload rather than relabeling these fields."
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "degrees",
        "reference"
      ],
      "properties": {
        "degrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "reference": {
          "enum": [
            "true-north",
            "magnetic-north",
            "unknown"
          ]
        },
        "accuracyDegrees": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Reported angular accuracy in degrees when available. Null or omitted means unknown; never treat missing accuracy as zero."
        },
        "deviceOrientation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "portrait",
            "portraitUpsideDown",
            "landscapeLeft",
            "landscapeRight",
            "faceUp",
            "faceDown",
            "unknown",
            null
          ],
          "description": "Device orientation used by the platform heading API, if known."
        },
        "activityType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "other",
            "automotiveNavigation",
            "fitness",
            "otherNavigation",
            "airborne",
            "unknown",
            null
          ],
          "description": "Core Location activity context configured when capturing the heading, if known. This is metadata, not a guarantee of accuracy."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceClass",
        "method"
      ],
      "properties": {
        "deviceClass": {
          "enum": [
            "iphone",
            "apple-watch",
            "manual-entry",
            "other"
          ]
        },
        "method": {
          "enum": [
            "device-compass",
            "gps-location",
            "coordinate-entry",
            "import",
            "other"
          ]
        },
        "deviceModel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "operatingSystemVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "sourceReference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "importedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "payloadSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "operatorNote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "reviewStatus": {
      "enum": [
        "candidate",
        "unverified",
        "accepted-for-context-only",
        "rejected"
      ]
    },
    "engineeringUse": {
      "const": "not-authorized",
      "description": "Device-compass waypoints are not authorized as survey, parcel-boundary, hydraulic-design, or regulatory evidence without independent validation."
    },
    "coordinateEpoch": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1900,
      "maximum": 2100,
      "description": "Observation's geometric reference-frame coordinate epoch when independently supplied; not a substitute for a datum realization or transformation."
    },
    "sourceHorizontalReferenceFrame": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "description": "Optional explicit realization, e.g. NAD83(2011); never infer this from EPSG:4326."
    }
  }
}
