{
  "uid": "tsm-living-twin",
  "title": "TSM Living Twin Runtime",
  "schemaVersion": 39,
  "tags": [
    "TSM"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Ingestion outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "twin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "twin-prometheus"
          },
          "expr": "sum by (outcome) (rate(twin_ingest_events_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Ingestion p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "twin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "twin-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(twin_ingest_seconds_bucket[5m])))",
          "legendFormat": "seconds"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pending delivery",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "twin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "twin-prometheus"
          },
          "expr": "twin_outbox_pending",
          "legendFormat": "{{destination}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbox delivery outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "twin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "twin-prometheus"
          },
          "expr": "sum by (destination,outcome) (rate(twin_outbox_delivery_total[5m]))",
          "legendFormat": "{{destination}} {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Open circuits",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "twin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "twin-prometheus"
          },
          "expr": "twin_circuit_open",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Materialized view refresh",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "twin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "twin-prometheus"
          },
          "expr": "sum by (outcome) (rate(twin_materialized_refresh_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
