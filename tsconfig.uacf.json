{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/uacf-gateway/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/agent-runtime/src/**/*.ts",
    "packages/registry/src/**/*.ts",
    "packages/router/src/**/*.ts",
    "packages/policy/src/**/*.ts",
    "packages/provenance/src/**/*.ts",
    "packages/events/src/**/*.ts",
    "packages/evidence/src/**/*.ts",
    "packages/gates/src/**/*.ts",
    "packages/provider-runtime/src/**/*.ts",
    "packages/model-runtime/src/**/*.ts",
    "packages/capability-runtime/src/**/*.ts",
    "packages/uacp/src/**/*.ts",
    "packages/ontology/src/**/*.ts",
    "packages/data-fabric/src/**/*.ts",
    "packages/twin/src/**/*.ts",
    "providers/local/src/**/*.ts",
    "providers/search/src/**/*.ts",
    "providers/browser/src/**/*.ts",
    "apps/dashboard/src/**/*.ts",
    "apps/playground/src/**/*.ts",
    "apps/docs/src/**/*.ts",
    "packages/providers/src/**/*.ts",
    "packages/search/src/**/*.ts",
    "packages/browser/src/**/*.ts",
    "packages/notifications/src/**/*.ts",
    "packages/jobs/src/**/*.ts",
    "packages/queues/src/**/*.ts",
    "packages/cache/src/**/*.ts",
    "packages/billing/src/**/*.ts",
    "packages/tenant/src/**/*.ts",
    "packages/approvals/src/**/*.ts",
    "packages/quantum/src/**/*.ts",
    "packages/compute/src/**/*.ts",
    "packages/units/src/**/*.ts",
    "packages/validation/src/**/*.ts"
  ]
}
