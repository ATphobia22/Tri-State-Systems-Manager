    "impacts": [
      {
        "stage": 28,
        "statement": "Most of New Harmony is flooded."
      },
      {
        "stage": 27.2,
        "statement": "This flood will exceed the highest stage on record.  Large amounts of property damage can be expected.  Evacuation of many businesses and homes becomes necessary."
      },
      {
        "stage": 24,
        "statement": "Flood waters enter city street in New Harmony."
      },
      {
        "stage": 21,
        "statement": "The river is 3 miles wide at I-64."
      },
      {
        "stage": 20,
        "statement": "Parts of northern New Harmony begin to flood and sandbagging becomes necessary in town."
      },
      {
        "stage": 19,
        "statement": "Harmonie State Park is closed. Surrounding bottomland is flooded."
      },
      {
        "stage": 15,
        "statement": "The river overflows low ground on the Illinois side."
      },
      {
        "stage": 10,
        "statement": "Some stripper oil wells begin to flood along the river from New Harmony to Mt. Vernon Indiana."
      }
    ]
